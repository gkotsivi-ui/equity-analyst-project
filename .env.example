# Copy to .env and replace with your name and Purdue email. Do not commit .env.
SEC_USER_AGENT=Your Name your.email@purdue.edu

# Needed for Lab 03, not Lab 02: an Anthropic API key from platform.claude.com (it starts with sk-ant-).
API_KEY=paste-your-provider-key-here

# Optional: the Anthropic model and effort the four roles use (defaults: claude-opus-5-5, medium).
# MODEL=claude-opus-5-5
# EFFORT=medium

# Optional: the class key for closing prices (P/E) from financialdatasets.ai.
FINANCIAL_DATASETS_API_KEY=paste-the-class-key-here

# Optional: the AI tools named on each report's AI-assistance line (default: Claude Code).
# AI_TOOLS=Codex, Claude Code
