# Copy to .env and replace with your name and Purdue email. Do not commit .env.
SEC_USER_AGENT=Your Name your.email@purdue.edu

# Needed for the roles and the Verifier, not for the seven steps (lab02_desk.py). Either key works:
# an Anthropic key from platform.claude.com (it starts with sk-ant-), or a Google AI Studio key
# from aistudio.google.com (it starts with AIza). The key picks the model provider.
API_KEY=paste-your-provider-key-here

# Optional: the model and effort the roles use. Defaults: claude-opus-5-5 for an Anthropic key,
# gemini-3.8-flash for a Google key. EFFORT applies to Anthropic models only.
# MODEL=claude-opus-5-5
# EFFORT=medium

# Optional: the class key for closing prices (P/E) from financialdatasets.ai. Without it, give --price.
FINANCIAL_DATASETS_API_KEY=paste-the-class-key-here

# Optional: the AI tools named on each report's AI-assistance line (default: Claude Code).
# AI_TOOLS=Codex, Claude Code
